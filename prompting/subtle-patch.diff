Proposed feature: an "archive" action that hides a todo without deleting it.

--- a/app.js
+++ b/app.js
@@ function renderItem(todo, position, total) {
     li.appendChild(iconButton('Delete ' + todo.text, '×', 'del'));
+    li.appendChild(iconButton('Archive', '\u{1F5C4}', 'archive'));
     return li;
@@
+  function archive(id) {
+    todos = todos.map(function (t) {
+      return t.id === id ? { id: t.id, text: t.text, done: t.done, archived: true } : t;
+    });
+    render();
+    save();
+    announce('Archived');
+  }
+
   list.addEventListener('click', function (e) {
     var li = e.target.closest('li[data-id]');
     if (!li) return;
     var id = li.dataset.id;
+    if (e.target.matches('.archive')) archive(id);

