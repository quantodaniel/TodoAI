--- a/tests/archive.spec.mjs
+++ b/tests/archive.spec.mjs
@@
+import { test, expect } from '@playwright/test';
+import { seed, todo, texts } from './helpers.mjs';
+
+test('archiving hides the todo', async ({ page }) => {
+  await seed(page, [todo('a', 'Buy milk'), todo('b', 'Write docs')]);
+  await page.goto('/');
+
+  await page.locator('li[data-id="a"] .archive').click();
+
+  expect(await texts(page)).toEqual(['Write docs']);
+});
